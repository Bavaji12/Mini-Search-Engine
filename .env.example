# Search Engine PostgreSQL Configuration
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change_me_in_production"
POSTGRES_DB="search_engine"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"

# Database Connection URL (AsyncPG)
DATABASE_URL="postgresql+asyncpg://postgres:change_me_in_production@localhost:5432/search_engine"

# Search Engine Defaults
DEFAULT_BM25_K1="1.5"
DEFAULT_BM25_B="0.75"
SNIPPET_WINDOW_SIZE="160"
PORT="8000"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
